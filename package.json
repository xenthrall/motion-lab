{
  "name": "tequia-motion-lab",
  "private": true,
  "version": "0.0.0",
  "description": "Laboratorio experimental de animacion SVG/DOM para la mascota de Tequia y futuros experimentos de motion design.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome format --write .",
    "svg:optimize": "svgo -f src/svg/mascot -o src/svg/mascot"
  },
  "dependencies": {
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.2",
    "svgo": "^3.3.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
